@page "/settings"
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1 class="h3 mb-4">Settings</h1>

@if (Model.Saved)
{
    <div class="alert alert-success" role="alert">Settings saved.</div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<form method="post" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="DataSource" class="form-label">Data source</label>
        <select asp-for="DataSource" class="form-select">
            <option value="Mock">Mock (sample data — always available)</option>
            <option value="GitHubLive">GitHub live (requires org billing access)</option>
        </select>
        <div class="form-text">
            Live data also requires a <code>GITHUB__TOKEN</code> environment variable set on the API process
            (a PAT with org billing read access) — it is never entered here.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="GitHubOrg" class="form-label">GitHub organization</label>
        <input asp-for="GitHubOrg" class="form-control" placeholder="e.g. contoso" />
        <span asp-validation-for="GitHubOrg" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MonthlyBudgetPerSeat" class="form-label">Monthly premium-request budget per seat</label>
        <input asp-for="MonthlyBudgetPerSeat" type="number" step="1" class="form-control" />
        <span asp-validation-for="MonthlyBudgetPerSeat" class="text-danger"></span>
        <div class="form-text">Used to compute each member's remaining capacity for the month.</div>
    </div>

    <div class="mb-3">
        <label asp-for="MinutesSavedPerRequest" class="form-label">Minutes saved per accepted request</label>
        <input asp-for="MinutesSavedPerRequest" type="number" step="0.5" class="form-control" />
        <span asp-validation-for="MinutesSavedPerRequest" class="text-danger"></span>
        <div class="form-text">
            An estimate, not a GitHub metric — tune it to match your team's own sense of time saved.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
